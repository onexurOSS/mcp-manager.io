# =============================================================================
# manager-mcp — Git ignore rules
# Prefer ignoring whole directories over listing individual files.
# =============================================================================

# -----------------------------------------------------------------------------
# Local tooling / agent scaffolding (do not commit)
# -----------------------------------------------------------------------------
# Cursor IDE project config, rules, hooks, and skills
.cursor/

# Claude 
.claude/

# Agent skill packs and local agent assets
.agents/

# Spec Kit / Specify local project config and templates
.specify/

# Graphify knowledge-graph output (regenerable)
graphify-out/

# Local live-RE probe dumps (may contain business data)
specs/**/_quote-*.json
specs/**/_quote-*.txt
specs/**/_scope-paths-probe.json
specs/**/_banking-*.json

# -----------------------------------------------------------------------------
# Environment & secrets
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
.mcp.json

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg
.venv/
venv/
ENV/

# -----------------------------------------------------------------------------
# Test / type / lint caches
# -----------------------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/

# -----------------------------------------------------------------------------
# OS / editor noise
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*.swo
*~
context-mode

# Built Claude Desktop bundle (build artifact; the copy shipped upstream is stale)
mcpb.mcpb
